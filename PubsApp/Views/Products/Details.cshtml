@model PubsApp.Models.ProductDetailsViewModel
@{
    ViewData["Title"] = Model.Product.ProductName;
    var product = Model.Product;
}

<div class="page-heading">
    <div><div class="eyebrow"><a class="text-link" asp-action="Index">Products</a> / Product detail</div><h1>@product.ProductName</h1><p>@product.Category?.CategoryName · Product #@product.ProductId</p></div>
    <div class="d-flex gap-2"><a class="btn-quiet" asp-action="Edit" asp-route-id="@product.ProductId">Edit product</a><a class="btn-quiet danger-link" asp-action="Delete" asp-route-id="@product.ProductId">Delete</a></div>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-info">@message</div>
}

<div class="metric-grid product-detail-metrics">
    <article class="metric-card"><div class="metric-label">Unit price</div><div class="metric-value">@product.UnitPrice?.ToString("C2")</div><div class="metric-foot">Current catalog price</div></article>
    <article class="metric-card"><div class="metric-label">In stock</div><div class="metric-value">@product.UnitsInStock</div><div class="metric-foot">Reorder level: @product.ReorderLevel</div></article>
    <article class="metric-card"><div class="metric-label">Units sold</div><div class="metric-value">@Model.UnitsSold.ToString("N0")</div><div class="metric-foot">From existing order details</div></article>
    <article class="metric-card"><div class="metric-label">Order lines</div><div class="metric-value">@Model.OrderLineCount</div><div class="metric-foot">Historical references</div></article>
</div>

<section class="detail-card">
    <div class="detail-grid">
        <div><div class="detail-label">Category</div><div class="detail-value">@(product.Category?.CategoryName ?? "Uncategorized")</div></div>
        <div><div class="detail-label">Package</div><div class="detail-value">@(product.QuantityPerUnit ?? "—")</div></div>
        <div><div class="detail-label">Availability</div><div class="detail-value">@(product.Discontinued ? "Discontinued" : "Active")</div></div>
        <div><div class="detail-label">Units on order</div><div class="detail-value">@product.UnitsOnOrder</div></div>
        <div><div class="detail-label">Supplier ID</div><div class="detail-value">@product.SupplierId</div></div>
        <div><div class="detail-label">Deletion</div><div class="detail-value">@(Model.OrderLineCount == 0 ? "No order history" : "Protected by order history")</div></div>
    </div>
</section>
